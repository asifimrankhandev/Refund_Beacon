{
  "expo": {
    "name": "Refund Beacon",
    "slug": "refund-beacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "refundbeacon",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F4F1",
    "ios": {
      "bundleIdentifier": "com.refundbeacon.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.refundbeacon.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F",
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.c2dm.permission.RECEIVE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE",
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
        "com.anddoes.launcher.permission.UPDATE_COUNT",
        "com.majeur.launcher.permission.UPDATE_BADGE",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS",
        "android.permission.READ_APP_BADGE",
        "com.oppo.launcher.permission.READ_SETTINGS",
        "com.oppo.launcher.permission.WRITE_SETTINGS",
        "me.everything.badger.permission.BADGE_COUNT_READ",
        "me.everything.badger.permission.BADGE_COUNT_WRITE"
      ]
    },
    "plugins": [
      "expo-router",
      ["expo-navigation-bar", { "enforceContrast": false }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F4F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E0E0D",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#0F0F0F",
                "dark": "#FF6A33"
              },
              "windowBackground": {
                "light": "#FFFFFF",
                "dark": "#1A1A18"
              },
              "textColorPrimary": {
                "light": "#0F0F0F",
                "dark": "#F2F2EE"
              },
              "textColorSecondary": {
                "light": "#5E5E5A",
                "dark": "#A3A39C"
              }
            },
            "timePicker": {
              "background": {
                "light": "#FFFFFF",
                "dark": "#1A1A18"
              },
              "headerBackground": {
                "light": "#0F0F0F",
                "dark": "#232320"
              },
              "numbersBackgroundColor": {
                "light": "#EDEDE8",
                "dark": "#232320"
              },
              "numbersTextColor": {
                "light": "#0F0F0F",
                "dark": "#F2F2EE"
              },
              "numbersSelectorColor": {
                "light": "#FF5A1F",
                "dark": "#FF6A33"
              }
            }
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF5A1F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Refund Beacon uses your photos only when you choose a receipt or screenshot to add as evidence.",
          "cameraPermission": "Refund Beacon uses the camera only when you photograph a receipt or label to add as evidence.",
          "microphonePermission": false
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "idexa",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "94b5e3fb-87f6-4851-9207-f7e421e6db4c"
      }
    }
  }
}
